# Only required for the optional "Archive" persistence feature.
# Everything else (scanning, filtering, import) runs without a database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Public-deployment abuse protection (optional, disabled by default) ---
# Server-authoritative fixed-window rate limiter (needs DATABASE_URL + `npx drizzle-kit push`).
# Guards POST /api/scan-batch, /api/scan, /api/import and /api/archive. See README §4.
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_WINDOW_SECONDS=60           # global default window
# RATE_LIMIT_MAX_REQUESTS=30             # global default quota per route per window
# RATE_LIMIT_MAX_REQUESTS_ARCHIVE=10     # per-route override (route upper-cased, "-" -> "_")
# RATE_LIMIT_WINDOW_SECONDS_ARCHIVE=3600

# Hard ceiling on stored archive sessions; oldest are pruned on insert. 0 disables.
# ARCHIVE_MAX_SESSIONS=200
